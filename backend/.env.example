# FleetWatch AI Backend — environment template
# Copy to Render/Railway env vars. NEVER commit real values.

# ── Core ──────────────────────────────────────────────────────────────
FW_CLOUD_TOKEN=generate-a-long-random-string
SITE=Home Test Lab
# DATABASE_URL=postgres://user:pass@host:5432/fleetwatch   # omit -> SQLite
FW_DB_PATH=/tmp/fleetwatch.db
FW_MAX_EVENTS=5000

# ── Alerts ────────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── TIER 1: detection provider (roboflow | robovision) ───────────────
DETECTION_PROVIDER=roboflow
ROBOFLOW_API_KEY=your-roboflow-key
ROBOFLOW_MODEL_ID=fleetwatch-detect/1
ROBOFLOW_API_URL=https://detect.roboflow.com
# ROBOVISION_API_KEY=your-robovision-key
# ROBOVISION_ENDPOINT=https://your-robovision-endpoint

# ── TIER 2: the reasoning council (all via OpenRouter) ───────────────
OPENROUTER_API_KEY=your-openrouter-key

COUNCIL_EYES_MODEL=google/gemini-2.0-flash-001
COUNCIL_ANALYST_MODEL=meta-llama/llama-4-maverick
COUNCIL_AGENT_MODEL=nousresearch/hermes-3-llama-3.1-70b
COUNCIL_NARRATOR_MODEL=openai/gpt-4.1-mini

# Per-seat kill switches (1=on, 0=off) — disable for data-residency/cost
COUNCIL_EYES_ENABLED=1
COUNCIL_ANALYST_ENABLED=1
COUNCIL_AGENT_ENABLED=1
COUNCIL_NARRATOR_ENABLED=1

# Optional: use Google's API directly for the EYES seat instead of OpenRouter
# GEMINI_DIRECT_KEY=your-google-key
