# FleetWatch AI Backend v3 — environment template
# Copy to Render/Railway env vars. NEVER commit real values.

# ── Core ──────────────────────────────────────────────────────────────
FW_CLOUD_TOKEN=generate-a-long-random-string
SITE=Home Test Lab
# DATABASE_URL=postgres://user:pass@host:5432/fleetwatch   # omit -> SQLite
FW_DB_PATH=/tmp/fleetwatch.db
FW_MAX_EVENTS=5000

# ── Notification Channels (comma-separated) ───────────────────────────
# Options: teams, slack, sms, voice, vms, emergency
NOTIFICATION_CHANNELS=teams

# ── Microsoft Teams ────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# ── Slack ──────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_BOT_TOKEN=xoxb-...   # use Bot token for richer messages
SLACK_ALERT_CHANNEL=#fleetwatch-alerts

# ── Twilio SMS + Voice ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+12135550100
ALERT_PHONE_NUMBERS=+12135550200,+19085550300   # comma-separated E.164

# ── VMS Webhook (Milestone, Genetec, Avigilon, Hanwha) ────────────────
VMS_WEBHOOK_URL=https://your-vms-server/alarm-webhook

# ── Emergency Dispatch (RapidSOS — requires signed contract) ──────────
# RAPIDSOS_API_KEY=your-rapidsos-bearer-token
# RAPIDSOS_ORG_ID=your-org-id
# RAPIDSOS_SANDBOX=1   # set to 1 during testing

# ── TIER 1: detection provider (roboflow | robovision) ───────────────
DETECTION_PROVIDER=roboflow
ROBOFLOW_API_KEY=your-roboflow-key
ROBOFLOW_MODEL_ID=fleetwatch-detect/1
ROBOFLOW_API_URL=https://detect.roboflow.com
# ROBOVISION_API_KEY=your-robovision-key
# ROBOVISION_ENDPOINT=https://your-robovision-endpoint

# ── TIER 2: the reasoning council (all via OpenRouter) ───────────────
OPENROUTER_API_KEY=your-openrouter-key

# Council combo: Gemini (eyes) + Llama (analyst) + Hermes (agent) + Narrator
COUNCIL_EYES_MODEL=google/gemini-2.0-flash-001
COUNCIL_ANALYST_MODEL=meta-llama/llama-4-maverick
COUNCIL_AGENT_MODEL=nousresearch/hermes-3-llama-3.1-70b
COUNCIL_NARRATOR_MODEL=openai/gpt-4.1-mini

# Per-seat kill switches (1=on, 0=off)
COUNCIL_EYES_ENABLED=1
COUNCIL_ANALYST_ENABLED=1
COUNCIL_AGENT_ENABLED=1
COUNCIL_NARRATOR_ENABLED=1

# Optional: use Google's API directly for the EYES seat
# GEMINI_DIRECT_KEY=your-google-key
